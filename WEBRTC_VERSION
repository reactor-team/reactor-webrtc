# Pinned upstream Google WebRTC milestone for our owned build.
#
# Bumping this file triggers a rebuild of all prebuilt artifacts (see
# webrtc-build/ and .github/workflows/webrtc-build.yml).
#
# WEBRTC_BRANCH  — a branch-heads milestone ref (verify the number against
#                  https://chromiumdash.appspot.com/branches — the number maps
#                  to a Chrome/WebRTC milestone, e.g. m132).
# WEBRTC_COMMIT  — the exact commit the branch resolved to. Leave empty to sync
#                  to the branch head; build.sh prints the resolved commit so it
#                  can be locked here for reproducibility.
# REACTOR_PATCH_LEVEL — bump when ./patches change without a milestone change.

WEBRTC_MILESTONE=branch-heads/7907
WEBRTC_BRANCH=branch-heads/7907
WEBRTC_COMMIT=a5ddff6086d96fd2356ad6c521525ea2803f7988
REACTOR_PATCH_LEVEL=3
