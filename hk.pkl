amends "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Config.pkl"

// Git hooks for reactor-webrtc, managed by hk (`mise run install-hooks`).
//
// Every step shells out to a `mise run <task>`, so the hooks and CI run the
// IDENTICAL checks - hk only decides WHEN they run. hk reads this file with its
// built-in pkl evaluator (no separate pkl tool); `hk validate` (run in CI)
// proves it parses.
hooks {
  // Fast, offline checks - nothing here compiles or hits the network.
  ["pre-commit"] {
    steps {
      ["fmt"] {
        glob = List("*.rs")
        check = "mise run fmt:check"
      }
      ["shell"] {
        glob = List("*.sh", "*.bash")
        check = "mise run lint:shell"
        exclusive = true
      }
      ["mise-tools-root"] {
        glob = List("**/mise.toml")
        check = "mise run lint:mise-tools-root"
        exclusive = true
      }
    }
  }
  // Heavier checks before pushing: clippy compiles (and, via build.rs
  // auto-detect, may fetch the prebuilt), and the lockfile drift check runs
  // (skipped when mise.toml + mise.lock already match the merge-base with main).
  ["pre-push"] {
    steps {
      ["clippy"] {
        glob = List("*.rs")
        check = "mise run clippy"
        exclusive = true
      }
      ["mise-lock"] {
        check = "mise run lint:mise-lock"
        exclusive = true
      }
    }
  }
  // Auto-trust mise on every checkout - including `git worktree add`, which
  // fires post-checkout inside the new worktree - so the pinned tools resolve
  // without a manual `mise trust`. Mirrors reactor's post-checkout leaning.
  ["post-checkout"] {
    steps {
      ["mise-trust"] {
        check = "mise trust --yes --quiet 2>/dev/null || true"
        exclusive = true
      }
    }
  }
}
