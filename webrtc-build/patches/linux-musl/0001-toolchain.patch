diff --git a/build/config/reactor_musl.gni b/build/config/reactor_musl.gni
new file mode 100644
--- /dev/null
+++ b/build/config/reactor_musl.gni
@@ -0,0 +1,5 @@
+# Reactor's musl target is a separate toolchain; host tools remain glibc.
+declare_args() {
+  reactor_musl = false
+  reactor_musl_sysroot = ""
+}
diff --git a/build/toolchain/linux/reactor_musl/BUILD.gn b/build/toolchain/linux/reactor_musl/BUILD.gn
new file mode 100644
--- /dev/null
+++ b/build/toolchain/linux/reactor_musl/BUILD.gn
@@ -0,0 +1,21 @@
+import("//build/toolchain/gcc_toolchain.gni")
+
+foreach(cpu, [ "x64", "arm64" ]) {
+  clang_toolchain("clang_$cpu") {
+    toolchain_args = {
+      current_os = "linux"
+      current_cpu = cpu
+      reactor_musl = true
+    }
+  }
+}
+
+# Distinct even for x64 -> x64: protobuf generators must run on the glibc
+# build host, while all objects in the shipped archives must use musl.
+clang_toolchain("host") {
+  toolchain_args = {
+    current_os = "linux"
+    current_cpu = host_cpu
+    reactor_musl = false
+  }
+}
