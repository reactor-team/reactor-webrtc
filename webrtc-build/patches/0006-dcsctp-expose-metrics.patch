+// Reactor: see the declaration and webrtc-build/patches/README.md (0006).
+std::optional<dcsctp::Metrics> DcSctpTransport::GetMetrics() const {
+  if (!network_thread_->IsCurrent()) {
+    return network_thread_->BlockingCall([this] { return GetMetrics(); });
+  }
+  if (!socket_)
+    return std::nullopt;
+  return socket_->GetMetrics();
+}
