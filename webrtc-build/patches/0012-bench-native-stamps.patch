+// Reactor bench stamps (0012, bench only). Microseconds; *_utc are wall clock
+// (the kernel's SO_TIMESTAMP is), the rest TimeMicros(). The last data channel
+// message received: 0 kernel arrival (utc), 1 DTLS read (utc), 2 DTLS read,
+// 3 SCTP read (decrypted), 4 message delivered. The last message sent: 5
+// SendData entry, 6 its first DTLS send, 7 its first datagram handed to the
+// kernel, 8 SendData return, 9 1 when 7 came from a batch flush.
+namespace reactor_bench {
+std::atomic<int64_t> g_stamps[16];
+thread_local int64_t g_cur[4];
+thread_local bool g_pend_dtls = false;
+thread_local bool g_pend_sock = false;
+}  // namespace reactor_bench
+
+extern "C" __attribute__((visibility("default"))) void reactor_bench_stamps(
+    int64_t* out,
+    int n) {
+  for (int i = 0; i < n && i < 16; ++i) {
+    out[i] = reactor_bench::g_stamps[i].load(std::memory_order_relaxed);
+  }
+}
 
