           task_queue_factory->CreateTaskQueue("VideoFrameTransformerQueue",
                                               transformation_queue_priority)) {}
 
+// Reactor: a task posted by OnTransformedFrame() holds a reference to this
+// delegate. When the sender is torn down while such a task is pending or still
+// unwinding, that task can drop the last reference, so this destructor runs on
+// `transformation_queue_` itself. Deleting a TaskQueueStdlib from its own thread
+// joins that thread: pthread_join fails with EDEADLK and PlatformThread aborts
+// ("Check failed: 0 == pthread_join(*handle_, nullptr) (0 vs. 35)"). Hand the
+// queue to another thread, which deletes (and joins) it once this task returns.
+RTPSenderVideoFrameTransformerDelegate::
+    ~RTPSenderVideoFrameTransformerDelegate() {
+  if (transformation_queue_ && transformation_queue_->IsCurrent()) {
+    TaskQueueBase* queue = transformation_queue_.release();
+    std::thread([queue] { queue->Delete(); }).detach();
+  }
+}
