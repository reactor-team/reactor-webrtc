@@ -78,7 +78,7 @@ int AsyncUDPSocket::Send(const void* pv,
   SentPacketInfo sent_packet(options.packet_id,
                              env_.clock().TimeInMilliseconds(),
                              options.info_signaled_after_sent);
-  CopySocketInformationToPacketInfo(cb, *this, &sent_packet.info);
+  FillPacketInfo(cb, &sent_packet.info);
   int ret = socket_->Send(pv, cb);
   NotifySentPacket(this, sent_packet);
   return ret;
@@ -91,7 +91,7 @@ int AsyncUDPSocket::SendTo(const void* pv,
   SentPacketInfo sent_packet(options.packet_id,
                              env_.clock().TimeInMilliseconds(),
