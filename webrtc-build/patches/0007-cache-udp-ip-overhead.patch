-  CopySocketInformationToPacketInfo(cb, *this, &sent_packet.info);
+  FillPacketInfo(cb, &sent_packet.info);
   if (has_set_ect1_options_ != options.ect_1) {
     // It is unclear what is most efficient, setting options on every sent
     // packet or when changed. Potentially, can separate send sockets be used?
@@ -106,6 +106,16 @@ int AsyncUDPSocket::SendTo(const void* pv,
   return ret;
 }
 
+void AsyncUDPSocket::FillPacketInfo(size_t packet_size_bytes,
+                                    PacketInfo* info) {
+  info->packet_size_bytes = packet_size_bytes;
+  if (ip_overhead_bytes_ == 0) {
+    // Stays 0, and is read again next time, while the socket has no address.
+    ip_overhead_bytes_ = socket_->GetLocalAddress().ipaddr().overhead();
+  }
+  info->ip_overhead_bytes = ip_overhead_bytes_;
+}
+
 int AsyncUDPSocket::Close() {
   return socket_->Close();
 }
