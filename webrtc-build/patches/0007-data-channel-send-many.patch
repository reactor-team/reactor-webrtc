+void SctpDataChannel::SendManyAsync(
+    std::vector<std::vector<uint8_t>> messages,
+    bool binary,
+    absl::AnyInvocable<void(RTCError) &&> on_complete) {
+  // Reactor (0007): posted like SendAsync, whatever the calling thread. Unlike
+  // SendAsync, a channel already detached from its transport still reports
+  // back, so the caller is never left waiting on `on_complete`.
+  scoped_refptr<SctpDataChannel> me(this);
+  network_thread_->PostTask([me = std::move(me), messages = std::move(messages),
+                             binary,
+                             on_complete = std::move(on_complete)]() mutable {
+    RTC_DCHECK_RUN_ON(me->network_thread_);
+    RTCError err = me->connected_to_transport()
+                       ? me->SendManyImpl(std::move(messages), binary)
+                       : RTCError(RTCErrorType::INVALID_STATE);
+    if (on_complete)
+      std::move(on_complete)(err);
+  });
+}
+
+// RTC_RUN_ON(network_thread_);
+RTCError SctpDataChannel::SendManyImpl(
+    std::vector<std::vector<uint8_t>> messages,
+    bool binary) {
+  // As SendImpl and SendDataMessage, for every message at once.
+  size_t bytes = 0;
+  for (const std::vector<uint8_t>& message : messages) {
+    bytes += message.size();
+  }
+  expected_buffer_amount_ += bytes;
+  if (state_ != kOpen || !controller_ || !id_n_.has_value()) {
+    error_ = RTCError(RTCErrorType::INVALID_STATE);
+    return error_;
+  }
+
+  SendDataParams send_params;
+  // Send as ordered if it is still going through OPEN/ACK signaling.
+  send_params.ordered = ordered_ || handshake_state_ != kHandshakeReady;
+  send_params.max_rtx_count = max_retransmits_;
+  send_params.max_rtx_ms = max_retransmit_time_;
+  send_params.type = binary ? DataMessageType::kBinary : DataMessageType::kText;
+
+  const size_t count = messages.size();
+  error_ = controller_->SendDataMany(*id_n_, send_params, std::move(messages));
+  MaybeSendOnBufferedAmountChanged();
+  if (error_.ok()) {
+    messages_sent_ += count;
+    bytes_sent_ += bytes;
+    return error_;
+  }
+
+  RTC_LOG(LS_ERROR) << "Closing the DataChannel due to a failure to send data, "
+                       "send_result = "
+                    << ToString(error_.type()) << ":" << error_.message();
+  CloseAbruptlyWithError(
+      RTCError(RTCErrorType::NETWORK_ERROR, "Failure to send data"));
+  return error_;
+}
