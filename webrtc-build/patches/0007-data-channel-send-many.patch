+  if (stream_state == stream_states_.end() ||
+      stream_state->second.closure_initiated ||
+      stream_state->second.incoming_reset_done ||
+      stream_state->second.outgoing_reset_done) {
+    RTC_LOG(LS_VERBOSE) << "Skipping messages on non-open stream with sid: "
+                        << sid;
+    return RTCError(RTCErrorType::INVALID_STATE);
+  }
+
+  // Checked for the whole batch first, so a rejected one sends nothing.
+  auto max_message_size = socket_->options().max_message_size;
+  for (const std::vector<uint8_t>& payload : payloads) {
+    if (max_message_size > 0 && payload.size() > max_message_size) {
+      RTC_LOG(LS_WARNING) << debug_name_
+                          << "->SendDataMany(...): "
+                             "Trying to send packet bigger "
+                             "than the max message size: "
+                          << payload.size() << " vs max of "
+                          << max_message_size;
+      return RTCError(RTCErrorType::INVALID_RANGE);
+    }
+  }
+
+  std::vector<dcsctp::DcSctpMessage> messages;
+  messages.reserve(payloads.size());
+  for (std::vector<uint8_t>& payload : payloads) {
+    // Taken before the empty-message byte below, as SendData does.
+    auto ppid =
+        dcsctp::PPID(static_cast<uint16_t>(ToPPID(params.type, payload.size())));
+    if (payload.empty()) {
