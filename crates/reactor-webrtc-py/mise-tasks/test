#!/usr/bin/env bash
#MISE description="[Testing] Install the built wheel and run the pytest suite"
set -euo pipefail
shopt -s nullglob
wheels=("$REPO_ROOT"/target/wheels/reactor_webrtc-*.whl)
WHEEL="${wheels[0]:-}"
if [ -z "$WHEEL" ]; then
  echo "no wheel found in target/wheels — run //crates/reactor-webrtc-py:build first" >&2
  exit 1
fi
# venv under target/ (already gitignored), so the test leaves no untracked files.
VENV="$REPO_ROOT/target/py-test-venv"
uv venv --python 3.12 "$VENV"
VIRTUAL_ENV="$VENV" uv pip install pytest "$WHEEL"
# One pytest process per test file: PeerConnectionFactory is a process-wide
# singleton (one factory per process), and test_loopback.py and
# test_encoded_track.py each create their own session-scoped factory.
for f in "$REPO_ROOT"/crates/reactor-webrtc-py/tests/test_*.py; do
  VIRTUAL_ENV="$VENV" uv run --no-project -- pytest "$f" -v
done
